# Walk With Me supports three interchangeable backends. Configure any one (or
# several — they form a fallback chain). Default priority: ollama (if
# OLLAMA_URL set) → openai → gemini, or override with CHAT_PROVIDERS below.

# ── OpenAI-compatible backend (Groq, OpenRouter, Together, Mistral, OpenAI,
#    llama.cpp, LM Studio, or Ollama's own /v1 endpoint) ──
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODELS=llama-3.3-70b-versatile
#   OpenRouter example:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODELS=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_MAX_OUTPUT_TOKENS=768
# OPENAI_TEMPERATURE=0.9
# OPENAI_TOP_P=0.95

# ── Google Gemini ──
GEMINI_API_KEY=your-gemini-api-key-here
# Comma-separated fallback chain, tried in order:
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Max tokens per reply (default 768 — fits 2–4 paragraphs):
# GEMINI_MAX_OUTPUT_TOKENS=768
# Hidden "thinking" tokens (count against max output tokens!). Default 0
# (disabled — prevents mid-sentence truncation and improves latency).
# Use -1 for dynamic thinking, a positive cap, or "off" to omit the setting:
# GEMINI_THINKING_BUDGET=0
# Response variety tuning (higher temp/top_p = less repetitive phrasing):
# GEMINI_TEMPERATURE=0.9
# GEMINI_TOP_P=0.95

# ── Local Ollama (not used on Vercel unless OLLAMA_URL is set) ──
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=walk-with-me
# OLLAMA_TEMPERATURE=0.85
# OLLAMA_TOP_P=0.92
# OLLAMA_REPEAT_PENALTY=1.2

# ── Explicit provider order (optional) ──
# Overrides the default chain; unconfigured names are skipped.
# CHAT_PROVIDERS=openai,gemini
