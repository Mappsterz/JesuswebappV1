# Required for Vercel / cloud deployment
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — Gemini performance tuning
# Fastest default for chat latency:
GEMINI_MODEL=gemini-2.5-flash-lite
# Balanced quality (slower than lite):
# GEMINI_MODEL=gemini-3.5-flash
# Max tokens per reply (default 768 — fits 2–4 paragraphs):
# GEMINI_MAX_OUTPUT_TOKENS=768
# Response variety tuning (higher temp/top_p = less repetitive phrasing):
# GEMINI_TEMPERATURE=0.9
# GEMINI_TOP_P=0.95

# Optional — local Ollama (not used on Vercel unless OLLAMA_URL is set)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=walk-with-me
# OLLAMA_TEMPERATURE=0.85
# OLLAMA_TOP_P=0.92
# OLLAMA_REPEAT_PENALTY=1.2
